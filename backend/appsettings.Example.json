{
  "Mongo": {
    "TransactionsEnabled": true
  },
  "MongoDbSettings": {
    "ConnectionString": "<mongo-connection-string>",
    "DatabaseName": "MondialEcoDev"
  },
  "JwtSettings": {
    "Issuer": "mondialbusiness.eu",
    "Audience": "mondialbusiness.eu",
    "Key": "<cryptographically-random-256-bit-base64-string>",
    "ExpiryHours": 8
  },
  "EmailSettings": {
    "SmtpServer": "smtp.zoho.com",
    "Port": 587,
    "Email": "<smtp-account>",
    "Password": "<smtp-password>"
  },
  "Twilio": {
    "Enabled": false,
    "AccountSid": "<twilio-account-sid>",
    "AuthToken": "<twilio-auth-token>",
    "FromNumber": "<twilio-from-number>"
  },
  "Sumsub": {
    "AppToken": "<sumsub-app-token>",
    "BaseUrl": "https://api.staging.sumsub.com",
    "WebhookSecret": "<sumsub-webhook-secret>"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "Mondial"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://mondialbusiness.eu"
    ]
  },
  "Ai": {
    "Enabled": true,
    "ModelRouting": {
      "DefaultModel": "openai/gpt-oss-20b:free",
      "Models": {
        "Probe": "openai/gpt-oss-20b:free",
        "IdeaClarifier": "openai/gpt-oss-20b:free",
        "BusinessPlan": "openai/gpt-oss-20b:free",
        "Forecast": "openai/gpt-oss-20b:free",
        "IdeaGenerator": "openai/gpt-oss-20b:free"
      }
    },
    "CreditCosts": {
      "Probe": 0,
      "IdeaClarifier": 1,
      "BusinessPlan": 5,
      "Forecast": 5
    },
    "CacheTtlSeconds": 86400,
    "Features": {
      "Clarifier": true,
      "BusinessPlan": true,
      "Forecast": true
    },
    "StarterCredits": 100,
    "GrantStarterCreditsToExisting": true
  },
  "Hangfire": {
    "WorkerCount": 4
  },
  "AllowedHosts": "*",
  "OpenRouter": {
    "ApiKey": "<openrouter-api-key>",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "HttpReferer": "https://mondialbusiness.eu",
    "AppTitle": "Mondial",
    "TimeoutSeconds": 120,
    "MaxRetries": 3
  }
}
