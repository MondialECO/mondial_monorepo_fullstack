{
  "MongoDbSettings": {
    "ConnectionString": "<mongo-connection-string>",
    "DatabaseName": "MondialEcoDev"
  },
  "JwtSettings": {
    "Issuer": "mondialbusiness.eu",
    "Audience": "mondialbusiness.eu",
    "Key": "<cryptographically-random-256-bit-base64-string>",
    "ExpiryHours": 8
  },
  "EmailSettings": {
    "SmtpServer": "smtp.zoho.com",
    "Port": 587,
    "Email": "<smtp-account>",
    "Password": "<smtp-password>"
  },
  "Twilio": {
    "Enabled": false,
    "AccountSid": "<twilio-account-sid>",
    "AuthToken": "<twilio-auth-token>",
    "FromNumber": "<twilio-from-number>"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "Mondial"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://mondialbusiness.eu"
    ]
  },
  "OpenRouter": {
    "ApiKey": "<openrouter-api-key — REQUIRED; supply via OpenRouter__ApiKey env var or user-secrets>",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "HttpReferer": "https://mondialbusiness.eu",
    "AppTitle": "Mondial",
    "TimeoutSeconds": 60,
    "MaxRetries": 3
  },
  "Ai": {
    "Enabled": true,
    "ModelRouting": {
      "DefaultModel": "openai/gpt-4o-mini",
      "Models": {
        "Probe": "openai/gpt-oss-20b:free",
        "IdeaClarifier": "openai/gpt-4o",
        "BusinessPlan": "openai/gpt-4o",
        "Forecast": "openai/gpt-4o"
      }
    },
    "CreditCosts": {
      "Probe": 0,
      "IdeaClarifier": 1,
      "BusinessPlan": 5,
      "Forecast": 5
    },
    "RegenerationLimit": 3,
    "CacheTtlSeconds": 86400,
    "Features": {
      "Clarifier": true,
      "BusinessPlan": true,
      "Forecast": true
    },
    "StarterCredits": 100,
    "GrantStarterCreditsToExisting": true
  },
  "Hangfire": {
    "WorkerCount": 4
  },
  "AllowedHosts": "*"
}
