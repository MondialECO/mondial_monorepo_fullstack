# Copy to .env on the VPS and fill in. NEVER commit the real .env.
# ASP.NET Core maps "__" to config section nesting (Section__Key).
# Real values must come from the secret manager / password manager
# (see docs for the canonical workflow). Placeholders use <angle-brackets>.

# --- Deployment ---
APP_DOMAIN=<your-domain>
ACME_EMAIL=<letsencrypt-contact-email>
APP_IMAGE=<container-image-tag>

# --- Redis (container; password also referenced by the app below) ---
REDIS_PASSWORD=<redis-password>

# --- App configuration (rotated secrets) ---
MongoDbSettings__ConnectionString=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MongoDbSettings__DatabaseName=MondialEcoDev
JwtSettings__Key=<cryptographically-random-256-bit-base64-string>
JwtSettings__Issuer=mondialbusiness.eu
JwtSettings__Audience=mondialbusiness.eu
EmailSettings__SmtpServer=smtp.zoho.com
EmailSettings__Port=587
EmailSettings__Email=<smtp-account>
EmailSettings__Password=<smtp-password>
Twilio__Enabled=false
Twilio__AccountSid=<twilio-account-sid>
Twilio__AuthToken=<twilio-auth-token>
Twilio__FromNumber=<twilio-from-number>
Redis__Configuration=redis:6379,password=<redis-password>,abortConnect=False
Redis__InstanceName=Mondial
Cors__AllowedOrigins__0=https://your-frontend-domain
# Optional: OpenTelemetry collector
# OpenTelemetry__OtlpEndpoint=http://otel-collector:4317

# --- AI infrastructure (C-1) ---
# OpenRouter API key (REQUIRED — app fails fast at startup if missing)
OpenRouter__ApiKey=
# Optional AI overrides
# Ai__Enabled=true
# Hangfire__WorkerCount=4
