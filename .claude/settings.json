{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_MODEL": "claude-haiku-4-5-20251001",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-haiku-4-5-20251001",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8192",
    "BASH_DEFAULT_TIMEOUT_MS": "60000",
    "DISABLE_TELEMETRY": "0"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "TodoWrite",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(curl -s -o p4_overview.png \"https://www.figma.com/api/mcp/asset/63e1c84b-32ab-4372-8d58-b293d5d89f71\")",
      "Bash(curl -s -o p4_captable.png \"https://www.figma.com/api/mcp/asset/c839201a-9d7e-4526-babf-f42fea1bbeee\")",
      "Read(//d/d/**)",
      "Bash(curl -s -o p4_dilution.png \"https://www.figma.com/api/mcp/asset/7a0625d9-0f4b-45ea-8b0b-d56813169611\")",
      "Bash(curl -s -o p4_history.png \"https://www.figma.com/api/mcp/asset/b66d68ef-8f33-4df9-8408-4853afb104af\")",
      "Bash(echo \"=== lint exit: $? ===\")",
      "Skill(ui-review)",
      "Skill(ui-review:*)",
      "Bash(curl -s http://localhost:3000/api/health)",
      "Bash(curl -s -L http://localhost:3000/dashboard/entrepreneur/phase-4)",
      "Skill(code-review)",
      "Skill(code-review:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Read(.env*)",
      "Read(**/.env*)"
    ]
  }
}
