    class Guard_HX,Hook_Progress,Hook_Stats,Hook_Refs,Hook_Forecast,Comp_LegalCard,Comp_HXCard,Comp_Docs,Comp_Chat,Comp_Notif active;
    class BK,P3_1,P3_2,P3_5,P3_6,P4_Engines,P4_Res,HX_Cap missing;
    class UI_Header,UI_ProjectCard,UI_ForecastCard,UI_LegalCard,UI_HXCard,UI_Vault,UI_ChatNotif,UI_Marketplace,UI_QuickActions,UI_Crossroads client;
