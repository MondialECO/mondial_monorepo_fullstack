flowchart TD
    %% =========================================================================
    %% CREATOR PHASE 2 -> PHASE 4 POST-CLEANUP DATA LINEAGE
    %% MONDIAL BUSINESS CREATION (MBC) CANONICAL POST-REMEDIATION BASELINE
    %% =========================================================================

    subgraph PHASE2 ["Phase 2: Project Identity & Brand Studio"]
        direction TB
        P2_Clarifier["AI Clarifier Session<br/>(ClarifierSessions Collection)<br/>• problemDefinition<br/>• targetAudience<br/>• proposedSolution<br/>• differentiation<br/>• clarityScore"]
        P2_Project["CreatorIdea.Project<br/>(CreatorIdeas Collection)<br/>• Name, Tagline, Concept<br/>• Problem, Solution, TargetUser<br/>• MarketGap, CreatorEdge<br/>• Category, Sector, Tags<br/>• ClarityScore"]
        P2_BrandKit["BrandKit Document<br/>(BrandKits Collection - CANONICAL AUTHORITY)<br/>• Strategy (Pillars, Tone, Traits)<br/>• Direction (4 Candidates)<br/>• Logo (6 Concepts, 7 SVG Variations)<br/>• Colors (5 Roles, AAA/AA Checked)<br/>• Typography (4 Roles, Font Pairings)"]
        P2_SummaryEcho["Project.Branding Derived Projection<br/>(CreatorIdea.Project.Branding)<br/>• brandingMethod ('ai_studio'/'skipped'/...)<br/>• logoAsset (URI)<br/>• colorPalette (Hex[])<br/>• typographyPairing ('Syne + DM Sans')<br/>• brandKitId, brandKitVersion, syncedAt"]

        P2_Clarifier -->|finalizeClarifier| P2_Project
        P2_Project -->|DeriveInitialStrategy| P2_BrandKit
        P2_BrandKit -->|SyncBrandKitSummaryAsync| P2_SummaryEcho
    end

    subgraph PHASE3 ["Phase 3: Business Plan Intelligence (Sequential 3.1 - 3.7)"]
        direction TB
        P3_1["3.1 Market Study<br/>(MarketStudySessions)<br/>• TamSamSom (TAM/SAM/SOM)<br/>• Competitors[]<br/>• TargetSegments[]<br/>• SizingRisks[], GapValidation"]
        P3_2["3.2 Business Model Canvas<br/>(BusinessModelSessions)<br/>• Canvas (9 Blocks)<br/>• RevenueTiers[]<br/>• UnitEconomics<br/>• PricingMechanisms[]"]
        P3_3["3.3 Financial Forecast<br/>(ForecastSessions - 36-Month Math Engine)<br/>• 12mo AI + 24mo Deterministic Extension<br/>• Revenue, Cost, Cash Flow, OPEX<br/>• BreakEvenMonth, Runway<br/>• ARPU, Fixed/Variable Costs"]
        P3_4["3.4 Legal & Compliance<br/>(CreatorLegalAssessment - CANONICAL AUTHORITY)<br/>• ApplicableItems[] with RulesFingerprint<br/>• PlanningReadinessPct<br/>• ConfiguredTaxMode (HT/TTC/Exempt)<br/>• StageBreakdowns[]<br/>• Compatibility: LegalChecklist BSON (0 readers)"]
        P3_5["3.5 Formation & Team<br/>(CreatorIdea.Phase3Data.FormationGenerator)<br/>• RecommendedType (SAS/SAS-U/SARL)<br/>• CreationChecklist[]<br/>• YouHave[] vs YouNeed[]<br/>• Syncs entity to FR-CORP-002"]
        P3_6["3.6 Executive Business Plan<br/>(BusinessPlanSessions - INDEPENDENT OF P4)<br/>• 12 Synthesized Sections<br/>• Generates with Phase4Data == null<br/>• Optional UI cross-reference to GTM"]
        P3_7["3.7 Investor Readiness<br/>(CreatorIdea.Phase3Data.InvestorReadinessScore)<br/>• OverallScore (0-100), Grade A-D<br/>• 5 Dimensions Assessment<br/>• Unlocks Phase 4 Construction"]

        P3_1 -->|MarketStudySessionId| P3_2
        P3_2 -->|BusinessModelSessionId| P3_3
        P3_1 & P3_2 & P3_3 -->|ProfileClassifier| P3_4
        P3_3 & P3_4 -->|ForecastBasis + LegalSignals| P3_5
        P3_1 & P3_2 & P3_3 & P3_4 & P3_5 -->|Synthesizes 12 Sections| P3_6
        P3_1 & P3_2 & P3_3 & P3_4 & P3_5 & P3_6 -->|5 Weighted Dimensions| P3_7
    end

    subgraph HUMAINX ["HumainX Canonical Profile & Capacity"]
        direction TB
        HX_Profile["ProfessionalProfileRecord<br/>(ProfessionalProfiles Collection)<br/>• QuickStart (Step1,2,3 Timestamps - SOLE AUTHORITY)<br/>• Skills[] (name, level, source)<br/>• VentureContext.Region<br/>• VentureContext.CurrentSituation<br/>• VentureContext.WeeklyAvailability<br/>• VentureContext.LearningPreference<br/>• VentureContext.DelegationPreference"]
        HX_Resolver["ProfileCompletenessResolver<br/>• Enforces 5 Mandatory Keys<br/>• Evaluates Phase4Ready Gate"]
        HX_Capacity["IFounderCapacityResolver<br/>• Sole Capacity Authority<br/>• Availability -> Weekly Load Points"]

        HX_Profile --> HX_Resolver
        HX_Profile --> HX_Capacity
    end

    subgraph PHASE4 ["Phase 4: Construction & Launch Preparation Engine"]
        direction TB
        P4_1["4.1 Construction Snapshot<br/>(CreatorJourney.Phase4Data.ConstructionSnapshot)<br/>• ReadyItems[], PartialItems[], MissingItems[]<br/>• SourceFingerprint Tracking<br/>• Status: Completed / InProgress / Stale"]
        P4_2["4.2 Operational Roadmap<br/>(CreatorJourney.Phase4Data.Roadmap)<br/>• 6 Horizons (NOW -> POST_LAUNCH)<br/>• Tasks[] with Stable Keys & Preserved Edits<br/>• Founder Capacity Constrained<br/>• Status: Active / InReview"]
        P4_3["4.3 Needs & Requirements<br/>(CreatorJourney.Phase4Data.NeedsAnalysis)<br/>• 6 Resource Categories<br/>• SystemStatus vs FounderState<br/>• Active Need != Covered Need<br/>• TrainingCandidate Tagging"]
        P4_4["4.4 Skills & Training<br/>(CreatorJourney.Phase4Data.SkillsPlan)<br/>• CapabilityResolutions[]<br/>• Modes: LEARN, DELEGATE, VERIFY<br/>• 0 Skill Gaps is Valid Resolved Stage"]
        P4_5["4.5 Aids, Grants & Support<br/>(CreatorJourney.Phase4Data.SupportPlan)<br/>• Aides-entreprises + Regional Adapters<br/>• EligibleToApply vs Awarded<br/>• 0 Aid Matches is Valid Resolved Stage<br/>• Potential Support != Spendable Cash"]
        P4_6["4.6 Pricing Strategy<br/>(CreatorJourney.Phase4Data.PricingStrategy)<br/>• PricingPolicyEngine is Sole Authority<br/>• 13 Supported Revenue Models<br/>• ConfiguredTaxMode (No crude B2B/B2C)<br/>• 4-Price Independence"]
        P4_7["4.7 GTM & Launch Strategy<br/>(CreatorJourney.Phase4Data.GtmStrategy)<br/>• Primary Launch Segment & ICP<br/>• Channel Portfolio & Load Caps<br/>• Strict Budget Safety: Planned vs Awarded<br/>• Validation Experiments & Stop Rules"]

        P4_1 -->|Snapshot Identified Gaps| P4_2
        P4_1 & P4_2 -->|Resource Requirements| P4_3
        P4_3 -->|Uncovered Competency Needs| P4_4
        P4_3 & P4_4 -->|Profile & Activity Context| P4_5
        P4_1 & P4_3 -->|Operating Cost Floors| P4_6
        P4_2 & P4_5 & P4_6 -->|Budget, Capacity, Pricing Inputs| P4_7
    end

    subgraph RESOLVER ["Phase 4 Gate & Resolution Authority"]
        direction TB
        P4_Resolver["Phase4CompletionResolver<br/>(Phase4CompletionResolver.Resolve)<br/>• Evaluates 4.1 to 4.7 Independently<br/>• 0 gaps / 0 aids = Valid Resolved<br/>• Sole Authority for Phase 4 Completion"]
        P5_Crossroads["Phase 5 Crossroads Gateway<br/>(POST /api/creator/journey/crossroads/path)<br/>• Gated by Phase4CompletionResolver<br/>• Direct API/Route Bypass Throws 403"]

        P4_1 & P4_2 & P4_3 & P4_4 & P4_5 & P4_6 & P4_7 --> P4_Resolver
        P4_Resolver -->|IsComplete == true| P5_Crossroads
    end

    subgraph FUTURE ["Future Approved Stages (Not Implemented)"]
        direction TB
        P4_8["4.8 Launch Assets<br/>(APPROVED NEXT EXTENSION - UNIMPLEMENTED)<br/>• One-Page Branded Launch Website<br/>• Consumes BrandKit, Project, Pricing, GTM<br/>• No Reverse Dependencies"]
        P4_9["4.9 Construction Readiness<br/>(RESERVED ARCHITECTURE)"]
    end

