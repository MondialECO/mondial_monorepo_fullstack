        P3_3["3.3 Financial Forecast<br/>(ForecastSessions)<br/>• 12mo AI + 24mo Projected (36mo)<br/>• Revenue, Cost, Cash Flow<br/>• BreakEvenMonth, Runway<br/>• MonthlyChurnPct, ARPU, OPEX"]
        P3_4["3.4 Legal & Compliance<br/>(CreatorIdea.Phase3Data.LegalAssessment)<br/>• ApplicableItems[]<br/>• PlanningReadinessPct<br/>• TaxMode (HT/TTC/Exempt)<br/>• StageBreakdowns[]"]
        P3_5["3.5 Formation & Team<br/>(CreatorIdea.Phase3Data.FormationGenerator)<br/>• RecommendedType (SAS/SAS-U/SARL)<br/>• CreationChecklist[]<br/>• YouHave[] vs YouNeed[]<br/>• CofounderBrief"]
        P3_6["3.6 Executive Business Plan<br/>(BusinessPlanSessions)<br/>• 12 Synthesized Sections<br/>• Editable working copy<br/>• PDF / Exportable Record"]
        P3_7["3.7 Investor Readiness<br/>(CreatorIdea.Phase3Data.InvestorReadinessScore)<br/>• OverallScore (0-100), Grade A-D<br/>• 5 Dimensions Breakdown<br/>• Specific Deductions[]"]

        P3_1 -->|MarketStudySessionId| P3_2
        P3_2 -->|BusinessModelSessionId| P3_3
        P3_1 & P3_2 & P3_3 -->|ProfileClassifier| P3_4
        P3_3 & P3_4 -->|ForecastBasis + LegalSignals| P3_5
        P3_1 & P3_2 & P3_3 & P3_4 & P3_5 -->|Assembled Upstream| P3_6
        P3_1 & P3_2 & P3_3 & P3_4 & P3_5 & P3_6 -->|5 Dimensions Weighted| P3_7
    end

    subgraph HUMAINX ["HumainX Canonical Profile"]
        direction TB
        HX_Profile["ProfessionalProfileRecord<br/>(ProfessionalProfiles Collection)<br/>• QuickStart (Step1,2,3 Timestamps)<br/>• Skills[] (name, level, source)<br/>• VentureContext.Region<br/>• VentureContext.CurrentSituation<br/>• VentureContext.WeeklyAvailability<br/>• VentureContext.LearningPreference<br/>• VentureContext.DelegationPreference<br/>• VentureContext.PreviousEntrepreneurialExperience"]
        HX_Resolver["ProfileCompletenessResolver<br/>• Checks 5 Required Keys<br/>• Determines Phase4Ready"]
        HX_Capacity["IFounderCapacityResolver<br/>• WeeklyAvailability -> Tier<br/>• Effort Budget / Load Points"]

        HX_Profile --> HX_Resolver
        HX_Profile --> HX_Capacity
    end

    subgraph PHASE4 ["Phase 4: Construction & Launch Preparation Engine"]
        direction TB
        P4_1["4.1 Construction Snapshot<br/>(CreatorJourney.Phase4Data.ConstructionSnapshot)<br/>• ReadyItems[]<br/>• PartialItems[]<br/>• MissingItems[]<br/>• CriticalItems[]<br/>• SourceReferences[]"]
