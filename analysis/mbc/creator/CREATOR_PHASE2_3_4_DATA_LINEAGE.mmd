    subgraph PHASE2 ["Phase 2: Project Identity & Brand Studio"]
        direction TB
        P2_Clarifier["AI Clarifier Session<br/>(ClarifierSessions)<br/>• problemDefinition<br/>• targetAudience<br/>• proposedSolution<br/>• differentiation<br/>• clarityScore"]
        P2_Project["CreatorIdea.Project<br/>(CreatorIdeas / CreatorJourneys)<br/>• Name, Tagline, Concept<br/>• Problem, Solution, TargetUser<br/>• MarketGap, CreatorEdge<br/>• Category, Sector, Tags<br/>• ClarityScore"]
        P2_BrandKit["BrandKit Document<br/>(BrandKits Collection)<br/>• Strategy (Pillars, Tone, Traits)<br/>• Direction (4 Candidates)<br/>• Logo (6 Concepts, 7 SVG Variations)<br/>• Colors (5 Roles, AAA/AA Checked)<br/>• Typography (4 Roles, Font Pairings)"]
        P2_SummaryEcho["Project.Branding Summary Echo<br/>(CreatorIdea.Project.Branding)<br/>• brandingMethod ('ai_studio'/'skipped'/...)<br/>• logoAsset (URI)<br/>• colorPalette (Hex[])<br/>• typographyPairing ('Syne + DM Sans')"]

        P2_Clarifier -->|finalizeClarifier| P2_Project
        P2_Project -->|DeriveInitialStrategy| P2_BrandKit
        P2_BrandKit -->|CommitBrandKitAndSync| P2_SummaryEcho
    end

    subgraph PHASE3 ["Phase 3: Business Plan Intelligence"]
        direction TB
