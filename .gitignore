# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
[Tt]est[Rr]esults/
*.trx
/tests/creator/e2e/.auth/
/backend/test-bin/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.tmp
*.temp
*.bak
*~

# local agent/tooling state
.agents/
.codex/
.tmp/

# env files (can opt-in for committing if needed)
.env*

# configuration files with secrets — use .Example for templates
backend/appsettings*.json
!backend/appsettings.Example.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .NET build output
bin/
obj/
out/

# .NET DataProtection key ring (Development persists to filesystem;
# Production uses Redis — Program.cs:142-154). Never commit keys.
**/.dataprotection-keys/

# Claude Code (per-developer machine-local config)
.claude/settings.local.json
**/.claude/settings.local.json

# Audit/Investigation reports (temporary analysis files)
AUDIT_*.md
BUILD_AND_ROUTES_TEST_REPORT.md
FINAL_STATUS*.md
HOMEPAGE_AUDIT*.md
IMPLEMENTATION_SUMMARY.md
ONBOARDING_FIX_SUMMARY.md
P0_IMPLEMENTATION_CHECKLIST.md
PERFORMANCE_SEO_OPTIMIZATION.md
PHASE_*_AUDIT_REPORT.md
PHASE_*_IMPLEMENTATION.md
PHASE_*_COMPLETE.md
UNIVERSAL_*.md
ENTREPRENEUR_*.md

# Runtime uploads, local document storage, and large test media assets
backend/uploads/
backend/storage/
test_image_huge.jpg
test_video_huge.mp4
